# Copy to .env and fill in what you use. Every variable is optional.

# Where the web app keeps its SQLite DB, uploads and generated audio
SONICTALES_DATA=data
# Reject uploads/pastes longer than this many characters of book text
SONICTALES_MAX_CHARS=300000
# Set to 1 when serving over HTTPS so the visitor cookie is marked Secure
SONICTALES_SECURE_COOKIES=0
# Finished audiobooks are deleted after this many days (0 = keep forever)
SONICTALES_RETENTION_DAYS=7

# LLM script builder (speaker + scene detection). Without it the offline heuristic builder is used.
ANTHROPIC_API_KEY=
SONICTALES_LLM_MODEL=claude-sonnet-5-5

# Cloud TTS engine (optional)
OPENAI_API_KEY=
